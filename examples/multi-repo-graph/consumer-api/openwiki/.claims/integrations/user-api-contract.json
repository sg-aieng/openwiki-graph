  "claims": [
    {
      "id": "claim_c0d0a1822d3745ed906f26091c7c16ca",
      "statement": "The consumer depends on an external User API producer whose base URL is configured through `user.api.base-url`, defaulting to `http://localhost:8080` in `application.properties`.",
      "evidence": [
        {
          "resource": "repo://README.md#L1-L28",
          "version": "repo-lines-v1:sha256:63b5a530b6d2044b799caa39637c7d5ae19c122dec4a3254452f7ce7fd744dee:"
        },
        {
